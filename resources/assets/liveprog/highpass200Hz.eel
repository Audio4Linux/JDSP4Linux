desc: High Pass Filter
author: djneba, adapted from @thepbone lowpass

slider1:freq=80<10,20000,1>Cut-off frequency (Hz)
slider2:qFactor=0.707<0.10,10.00,0.01>Q factor

@init
function HighPassFilter_Set(frequency, qFactor) (
    x = (frequency * 2 * $PI) / srate;
    sinX = sin(x);
    y = sinX / (qFactor * 2);
    cosX = cos(x);
    z = (1 + cosX) / 2;

    _a0 = y + 1;
    _a1 = cosX * -2;
    _a2 = 1 - y;
    _b0 = z;    
    _b1 = -(1 + cosX);    
    _b2 = z;    
    
    this.y_2 = 0; this.y_1 = 0; this.x_2 = 0; this.x_1 = 0;
    this.b0 = _b0 / _a0;
    this.b1 = _b1 / _a0;
    this.b2 = _b2 / _a0;
    this.a1 = -_a1 / _a0;
    this.a2 = -_a2 / _a0;
);

function HighPassFilter_ProcessSample(sample) (
    out = sample * this.b0
        + this.x_1 * this.b1
        + this.x_2 * this.b2
        + this.y_1 * this.a1
        + this.y_2 * this.a2;

    this.y_2 = this.y_1;
    this.y_1 = out;
    this.x_2 = this.x_1;
    this.x_1 = sample;

    out;
);

@slider
hipass.HighPassFilter_Set(freq, qFactor);

@sample
spl0 = hipass.HighPassFilter_ProcessSample(spl0);
spl1 = hipass.HighPassFilter_ProcessSample(spl1);
